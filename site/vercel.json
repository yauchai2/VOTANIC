{
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "xrcc-remote-trigger.vercel.app"
        }
      ],
      "destination": "https://votanic-proto.vercel.app/remote-trigger/",
      "permanent": false
    },
    {
      "source": "/ai-provider/index.html",
      "destination": "https://votanic-proto.vercel.app/ai-provider/",
      "permanent": true
    },
    {
      "source": "/ai-provider",
      "destination": "https://votanic-proto.vercel.app/ai-provider/",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "xrcc-remote-trigger.vercel.app"
        }
      ],
      "destination": "https://votanic-proto.vercel.app/:path*",
      "permanent": false
    },
    {
      "source": "/remote-trigger",
      "destination": "/remote-trigger/",
      "permanent": false
    },
    {
      "source": "/voyage360",
      "destination": "/voyage360/",
      "permanent": false
    }
  ]
}
